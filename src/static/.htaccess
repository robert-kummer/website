# Apache-Konfiguration für robert-kummer.de (Mittwald). Wird von build.py erzeugt.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

# Dateitypen ------------------------------------------------------------------
AddType text/markdown;charset=utf-8 .md
AddType text/plain;charset=utf-8 .txt
AddType text/vcard;charset=utf-8 .vcf
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType font/woff2 .woff2
<Files "webmcp">
  ForceType application/json
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer HTTPS, immer ohne www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://robert-kummer.de%{REQUEST_URI} [R=301,L,NE]

  # Markdown per Content Negotiation: Accept: text/markdown liefert index.md
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.md -f
  RewriteRule ^(.*?)/?$ $1/index.md [L,E=MD_NEGOTIATED:1]
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^$ index.md [L,E=MD_NEGOTIATED:1]
</IfModule>

<IfModule mod_headers.c>
  # Sicherheit
  Header always set Content-Security-Policy "{{csp_header}}"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Origin-Agent-Cluster "?1"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By

  # Maschinenlesbares darf von überall gelesen werden
  <FilesMatch "\.(md|txt|vcf|xml|webmanifest)$|^webmcp$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>

  # Wer HTML oder Markdown je nach Accept bekommt, muss das im Cache trennen
  Header append Vary "Accept" "expr=%{REQUEST_URI} =~ m#(/|\.md)$#"
  Header set Link "<{{site.url}}llms.txt>; rel=\"alternate\"; type=\"text/plain\"" "expr=%{CONTENT_TYPE} =~ m#^text/html#"

  # Caching: Dateien mit Hash im Namen für immer, alles andere neu prüfen
  <FilesMatch "\.[0-9a-f]{10}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|jpg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html|md|txt|xml|vcf|webmanifest)$|^webmcp$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Kompression -----------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/markdown text/vcard text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown text/vcard text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
  </IfModule>
</IfModule>
